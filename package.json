{
  "name": "idef-gojs",
  "version": "1.0.0",
  "description": "Domain-Driven & Hexagonal Architecture (Ports & Adapters) IDEF1 / IDEF1X Diagramming Engine built on GoJS",
  "type": "module",
  "main": "./dist/idef-gojs.cjs.js",
  "module": "./dist/idef-gojs.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/idef-gojs.es.js",
      "require": "./dist/idef-gojs.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "idef1",
    "idef1x",
    "gojs",
    "diagram",
    "hexagonal-architecture",
    "ddd",
    "ports-and-adapters",
    "entity-relationship",
    "data-modeling"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "gojs": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
