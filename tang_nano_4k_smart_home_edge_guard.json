        "hardware": "Gowin 55nm FPGA Fabric",
        "processingCapacity": "74.25 MHz Pixel Clock / 371.25 MHz TMDS Serializer"
      },
      {
        "id": "node-cortex-m3",
        "name": "Embedded Hard ARM Cortex-M3",
        "nodeType": "EXECUTION_ENVIRONMENT",
        "os": "FreeRTOS Embedded Microkernel",
        "hardware": "32-bit Cortex-M3 Core @ 83.3 MHz",
        "processingCapacity": "100 DMIPS, 32KB SRAM, 256KB User Flash"
      },
      {
