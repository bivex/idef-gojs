      }
    ],
    "components": [
      {
        "id": "comp-dvp-ingest",
        "name": "DVP Camera Capture & Frame Sync",
        "componentType": "MODULE",
        "technology": "Verilog HDL (Dual-Clock FIFO + Gray Counter)",
        "executionNodeId": "node-fpga-fabric"
      },
      {
        "id": "comp-sobel-motion",
        "name": "Sobel 3x3 Edge & Multi-Zone Motion Engine",
        "componentType": "MODULE",
        "technology": "Verilog Hardware DSP Pipeline",
        "executionNodeId": "node-fpga-fabric"
      },
      {
        "id": "comp-osd-hdmi",
        "name": "OSD Blender & TMDS HDMI 720p60 TX",
        "componentType": "MODULE",
        "technology": "Gowin OSER10 + 8b10b DVI Encoder",
        "executionNodeId": "node-fpga-fabric"
      },
      {
        "id": "comp-firmware-controller",
        "name": "Access Control & Event Telemetry Engine",
        "componentType": "SERVICE",
        "technology": "C / Embedded FreeRTOS",
        "executionNodeId": "node-cortex-m3"
      },
